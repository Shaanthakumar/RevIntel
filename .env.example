# RevIntel Environment Configuration

# Application Settings
APP_NAME=RevIntel
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api

# Database Settings
# Use SQLite for local development fallback, or PostgreSQL URI for production
DATABASE_URL=sqlite:///./revintel.db
# DATABASE_URL=postgresql://user:password@localhost:5432/revintel_db

# Security & Auth (Placeholders for future authentication phase)
SECRET_KEY=revintel-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / AI Revenue Agent Settings (Plug-in Provider)
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o

# Storage Settings
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
MODEL_DIR=./models
